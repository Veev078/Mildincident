{
  "name": "mildincident",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private editorial production and draft-handoff safeguards for MILDINCIDENT",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js web/tests/*.test.js",
    "test:browser": "node test/browser-workspace.mjs",
    "check": "node scripts/check.mjs",
    "preflight": "node src/cli.js prepare",
    "ledger": "node src/cli.js ledger",
    "studio": "node src/studio.js",
    "workspace": "node --use-env-proxy --use-system-ca src/workspace/server.js",
    "audit:n8n": "node --use-env-proxy --use-system-ca src/audit.js",
    "audit:production": "node --use-env-proxy --use-system-ca src/production-audit.js",
    "audit:buffer": "node --use-env-proxy --use-system-ca src/buffer-audit.js"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
