# Non-secret template only. Set actual values in the hosting provider's secret settings.
STUDIO_MODE=hosted
STUDIO_PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
STUDIO_DATA_DIR=/var/data/mildincident
STUDIO_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_VERIFIER
N8N_API_KEY=SET_EXISTING_KEY_IN_PROVIDER_SECRET_SETTINGS
STUDIO_SYNC_INTERVAL_MS=120000
# Buffer is optional and is not needed for research delivery. Do not add it for this milestone.
# PORT is supplied by the hosting provider; the application binds to 0.0.0.0 in hosted mode.
